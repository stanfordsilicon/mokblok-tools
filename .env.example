# Copy to `.env.local` and fill in real values. Never commit secrets.

# MongoDB Atlas connection string for the shared SILICON cluster.
MONGODB_URI=

# Auth.js signing/encryption secret. Generate with: `npx auth secret`
AUTH_SECRET=

# Shared Google OAuth client credentials.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Pin the public app origin used for OAuth callbacks.
# Local development should usually stay on `http://localhost:3000`.
AUTH_URL=http://localhost:3000

# Comma-separated allowlists. Leave blank to allow any Google account.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=

# Shared database holding users/accounts/sessions/user_items. Defaults to "silicon".
SILICON_DB_NAME=silicon

# Trust forwarded host headers if your platform requires them.
AUTH_TRUST_HOST=true
